# Flask 환경 변수 예시
# 이 파일을 .env로 복사하고 실제 값을 입력하세요
# 주의: .env 파일은 절대 Git에 커밋하지 마세요!

# Flask 설정
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True

# 보안
SECRET_KEY=your-secret-key-here-change-this-in-production

# 데이터베이스 (로컬 개발용)
DATABASE_URL=postgresql://localhost/flask_journal_dev

# Azure 설정 (프로덕션용 - Key Vault에서 가져옴)
# SECRET_KEY=@Microsoft.KeyVault(SecretUri=...)
# DATABASE_URL=@Microsoft.KeyVault(SecretUri=...)

# Azure Storage
STORAGE_ACCOUNT_NAME=
STORAGE_CONTAINER_NAME=uploads

# Application Insights
APPINSIGHTS_INSTRUMENTATIONKEY=

# 파일 업로드 설정
UPLOAD_FOLDER=/tmp/uploads
MAX_CONTENT_LENGTH=16777216

# 로깅
LOG_LEVEL=INFO
