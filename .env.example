# Flask Journal Demo Environment Variables

# Secret key for Flask session security
# Generate a secure random key for production use
SECRET_KEY=your-production-secret-key-here

# Flask debug mode (only enable in development)
# Set to 'true' for development, 'false' or omit for production
FLASK_DEBUG=false

# Example of generating a secure key:
# python -c "import secrets; print(secrets.token_hex(32))"